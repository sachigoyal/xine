{
  "name": "xine",
  "version": "1.0.2",
  "description": "CLI tool for generating and managing crypto wallets",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "xine": "./dist/index.js"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target node --minify",
    "link": "bun link",
    "publish": "bun run build && bun publish --access public"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sachigoyal/xine.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "author": "Sachi Goyal",
  "license": "MIT",
  "keywords": [
    "wallet",
    "crypto",
    "cli",
    "solana",
    "ethereum"
  ],
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@solana/web3.js": "^1.98.4",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "clipboardy": "^5.0.2",
    "commander": "^14.0.2",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.16.0",
    "tweetnacl": "^1.0.3"
  }
}
